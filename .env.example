# Kharcha — Environment Variables
# Copy this to .env.local and fill in your values.
# All EXPO_PUBLIC_ vars are embedded in the app bundle — never put secrets here.

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Gmail API
# Create OAuth 2.0 Client IDs for iOS, Android, and Web
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com

# ─── NVIDIA AI (server-side only — do NOT use EXPO_PUBLIC_ prefix) ───────────
# NVIDIA_API_KEY lives ONLY in the Supabase Edge Function environment.
# Set secrets via CLI:
# supabase secrets set NVIDIA_API_KEY=nvapi-your-key
# supabase secrets set NVIDIA_MODEL=deepseek-ai/deepseek-v3
# supabase secrets set NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional resiliency tuning for mobile UX:
# supabase secrets set NVIDIA_TIMEOUT_MS=8000
# supabase secrets set NVIDIA_MAX_RETRIES=2
# NEVER put your NVIDIA key in this file or any EXPO_PUBLIC_ variable.

# ─── Edge Function CORS (server-side only) ────────────────────────────────────
# Restricts which origins can call the generate-nudge Edge Function.
# Set via CLI: supabase secrets set ALLOWED_ORIGIN=your-app-scheme://
# If unset, defaults to * (all origins). Recommended to restrict in production.

